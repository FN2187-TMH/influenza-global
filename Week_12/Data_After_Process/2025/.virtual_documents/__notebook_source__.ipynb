    era5_spark
    .withColumn('temperature_c',    F.col('temperature_k') - 273.15)
    .withColumn('precipitation_mm', F.col('precipitation_m') * 1000)
    .withColumn('relative_humidity', calc_rh_spark(F.col('temperature_k'), F.col('dewpoint_k')))
)
 
