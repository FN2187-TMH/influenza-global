    # ISO year/week: xử lý đúng tuần 52/53 ở ranh giới năm
    .withColumn('year', F.year(F.col('time')))
    .withColumn('week', F.weekofyear(F.col('time')))
)
 
# Bước 2: Unit conversion trên Spark (lazy)
