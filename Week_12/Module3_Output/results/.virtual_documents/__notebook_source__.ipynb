# ── 1) Adjacency matrix (normalized route weights) ────────────────
adj = nx.to_numpy_array(G_undirected, nodelist=nodes, weight='weight')
# Normalize: mỗi hàng chia cho tổng → trọng số tương đối
row_sums = adj.sum(axis=1, keepdims=True)
row_sums[row_sums == 0] = 1  # tránh chia 0
adj_norm = adj / row_sums

# ── 2) Tính raw risk cho mỗi (country, year, week) ───────────────
# raw_risk(c, t) = Σ_neighbors [ flu(neighbor, t) × normalized_route_weight(c, neighbor) ]
# Đây là weighted sum: nước có nhiều đường bay + nhiều ca bệnh → đóng góp risk cao

flu_pivot = flu_pivot.fillna(0)  # ← FIX: NaN → 0 trước khi tính risk

risk_rows = []
for (year, week), flu_week in flu_pivot.iterrows():
    # Vector flu cases tại thời điểm (year, week), aligned với nodelist
    flu_vec = np.nan_to_num(np.array([float(flu_week.get(c, 0)) for c in nodes]))

    # Matrix multiply: adj_norm @ flu_vec = weighted neighbor flu cho mỗi nước
    risk_vec = adj_norm @ flu_vec

    for i, country in enumerate(nodes):
        risk_rows.append({
            'country_iso3': country,
            'year': int(year),
            'week': int(week),
            'neighbor_flu_weighted': risk_vec[i],
        })

risk_df = pd.DataFrame(risk_rows)

# ── 3) Scale → 0-100 ─────────────────────────────────────────────
# MinMax scaling per (year, week) để so sánh fair giữa các tuần
# (tuần mùa đông tổng ca cao hơn tuần mùa hè)
def minmax_scale_group(group):
    vals = group['neighbor_flu_weighted']
    vmin, vmax = vals.min(), vals.max()
    if vmax > vmin:
        group['risk_score'] = ((vals - vmin) / (vmax - vmin) * 100).round(1)
    else:
        group['risk_score'] = 0.0
    return group

risk_df = risk_df.groupby(['year','week'], group_keys=False).apply(minmax_scale_group)

